<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets the integration tests reach their mock server
     over plain HTTP on the device (127.0.0.1, localhost) or the host
     (10.0.2.2 from the emulator). Release builds keep the platform default,
     which allows HTTPS only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
