{
  "name": "5xx keeps events, backs off 30 s and resends the identical batch",
  "steps": [
    {"op": "respond", "status": 503},
    {"op": "track", "name": "E1"},
    {"op": "track", "name": "E2"},
    {"op": "flush"},
    {"op": "check", "requests": 1, "queueLength": 2},
    {"op": "advance", "ms": 29999},
    {"op": "flush"},
    {"op": "check", "requests": 1},
    {"op": "advance", "ms": 1},
    {"op": "flush"}
  ],
  "expect": {
    "requests": [
      {
        "$partial": true,
        "events": [
          {"$partial": true, "name": "E1"},
          {"$partial": true, "name": "E2"}
        ]
      },
      {"$partial": true, "events": {"$sameAs": "requests[0].events"}}
    ],
    "queueLength": 0
  }
}
