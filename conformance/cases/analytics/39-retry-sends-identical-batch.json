{
  "name": "the retry after a 429 resends the identical batch; later events go after it",
  "steps": [
    {"op": "respond", "status": 429, "headers": {"Retry-After": "60"}},
    {"op": "track", "name": "E1"},
    {"op": "track", "name": "E2"},
    {"op": "flush"},
    {"op": "track", "name": "E3"},
    {"op": "advance", "ms": 60000}
  ],
  "expect": {
    "requests": [
      {
        "$partial": true,
        "events": [{"$partial": true, "name": "E1"}, {"$partial": true, "name": "E2"}]
      },
      {"$partial": true, "events": {"$sameAs": "requests[0].events"}},
      {"$partial": true, "events": [{"$partial": true, "name": "E3"}]}
    ],
    "queueLength": 0
  }
}
